/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf/dkfz_rnaseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    input        = "assets/samplesheet.csv"
    outdir       = "results"
    generate_star_index = true
    genome       = "R64-1-1"
    seq_center   = "dkfz"
    seq_platform = "trueseq"
    clip3pAdapterSeq_R1  = "AGATCGGAAGAGCACACGTCTGAACTCCAGTCA"
    clip3pAdapterSeq_R2  =  "AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT"
    clip3pAdapterMMp_R1 = "0.1" 
    clip3pAdapterMMp_R2 = "0.1" 
    sjdbOverhang        = 200
}
