/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/fastqc"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'STAR_GENOMEGENERATE'{
        ext.args = {"--sjdbOverhang ${params.sjdbOverhang}"}
        ext.prefix = {"${params.genome}_${params.sjdbOverhang}"}
        publishDir = [
                path: {"${params.outdir}/indexes/star/${params.genome}_${params.sjdbOverhang}"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'KALLISTO_INDEX'{
        publishDir = [
                path: {"${params.outdir}/indexes/kallisto"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'SALMON_INDEX'{
        publishDir = [
                path: {"${params.outdir}/indexes/salmon"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'RSEM_PREPAREREFERENCE'{
        publishDir = [
                path: {"${params.outdir}/indexes/rsem"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    // missing parametrs should be arranged for hg19 and hg38

    withName: 'NF_DKFZ_RNASEQ:DKFZ_RNASEQ:STAR_WF:STAR_ALIGN' {
            ext.args   = { [
                "--genomeLoad NoSharedMemory",
                "--readFilesCommand zcat",
                "--quantMode TranscriptomeSAM",
                "--sjdbOverhang ${params.sjdbOverhang} --runRNGseed 1234 --outSAMtype BAM Unsorted SortedByCoordinate ",
                "--outSAMstrandField intronMotif --outSAMunmapped Within KeepPairs --outFilterMultimapNmax 1 --outFilterMismatchNmax 5 --outFilterMismatchNoverLmax 0.3 --twopassMode Basic --twopass1readsN -1",
                "--outSAMattrRGline ID:${meta.id} LB:${meta.library} PL:${params.seq_platform} SM:${meta.sample} PU:${meta.platform_unit}",
                "--chimSegmentMin 15 --chimScoreMin 1 --chimScoreJunctionNonGTAG 0 --chimJunctionOverhangMin 15  --chimSegmentReadGapMax 3 --alignSJstitchMismatchNmax 5 -1 5 5 --chimOutType Junctions SeparateSAMold",
                params.clip3pAdapterSeq_R1 ? (meta.single_end ? "--clip3pAdapterSeq ${params.clip3pAdapterSeq_R1}" : "--clip3pAdapterSeq ${params.clip3pAdapterSeq_R1} ${params.clip3pAdapterSeq_R2}") : "",
                params.clip3pAdapterMMp_R1 ? (meta.single_end ? "--clip3pAdapterMMp ${params.clip3pAdapterMMp_R1}" : "--clip3pAdapterMMp ${params.clip3pAdapterMMp_R1} ${params.clip3pAdapterMMp_R2}") : ""
            ].join(' ').trim() }
            ext.prefix = { "${meta.id}_STAR" }
            publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/star_alignment"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

    // star align parameters for arriba is different!
    withName: 'NF_DKFZ_RNASEQ:DKFZ_RNASEQ:STAR_ARRIBA_WF:STAR_ALIGN' {
            ext.args   = { [
                "--genomeLoad NoSharedMemory",
                "--readFilesCommand zcat",
                "--outSAMtype BAM Unsorted --outBAMcompression 0",
                "--outFilterMultimapNmax 50 --peOverlapNbasesMin 10",
                "--outSAMattrRGline ID:${meta.id} LB:${meta.library} PL:${params.seq_platform} SM:${meta.sample} PU:${meta.platform_unit}",
                "--chimSegmentMin 10 --chimScoreDropMax 30 --chimScoreSeparation 1 --chimScoreJunctionNonGTAG 0 --chimJunctionOverhangMin 10  --chimSegmentReadGapMax 3",
                "--chimMultimapNmax 50 --alignSJstitchMismatchNmax 5 -1 5 5 --alignSplicedMateMapLminOverLmate 0.5 --chimOutType WithinBAM HardClip",
            ].join(' ').trim() }
            ext.prefix = { "${meta.id}_STAR_ARRIBA" }
            publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/star_arriba_alignment"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

    withName: 'NF_DKFZ_RNASEQ:DKFZ_RNASEQ:STAR_ARRIBA_WF:SAMTOOLS_VIEW' {
        ext.prefix = { "${meta.id}_novirus" }
        ext.args = { "--output-fmt BAM,level=1 -e 'rname!~\"${params.ignoreViruses}\"'" }
    }


    withName: SAMTOOLS_SORT{
        ext.prefix = {bam.baseName + "_sorted"}
        publishDir = [
            enabled: false
        ]
    }
    withName: GUNZIP{
        publishDir = [
            enabled: false
        ]
    }

    withName: FIND_CONCATENATE{
        ext.prefix = {"${meta.id}" + "_virus.fa"}
        publishDir = [
                path: {"${params.outdir}/indexes/arriba"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'SAMBAMBA_MARKDUP'{
        ext.prefix = {bam.baseName + "_markdup"} 
        scratch = true
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/star_alignment"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'SAMBAMBA_FLAGSTAT'{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/star_alignment"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'FINGERPRINTING'{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/qc"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'RNASEQC' {
        ext.prefix = {bam.baseName}
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/qc/rnaseqc"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'QUALIMAP_RNASEQ' {
        ext.prefix = {bam.baseName}
        ext.args = "-s"
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/qc/qualimap"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }    

    withName: 'NF_DKFZ_RNASEQ:DKFZ_RNASEQ:FEATURECOUNTS_PLAIN:SUBREAD_FEATURECOUNTS'{
        ext.prefix = {meta.id + "_featureCounts"}
        ext.args   = { [
                "-t exon -g gene_id -Q 255 -F GTF",
                meta.single_end ? "" : "-B"
            ].join(' ').trim() }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'NF_DKFZ_RNASEQ:DKFZ_RNASEQ:FEATURECOUNTS_DEXSEQ:SUBREAD_FEATURECOUNTS'{
        ext.prefix = {meta.id + "_featureCountsExons"}
        ext.args = "-f -O -t exonic_part -Q 255 -F GTF"
        publishDir = [
            enabled: false
        ]
    }

    withName: 'FKPM_CALCULATOR'{
        ext.prefix = {meta.id + ".fpkm_tpm.featureCounts"}
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/featurecounts/plain/"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    
    withName: 'FKPM_CALCULATOR_DEXSEQ'{
        ext.prefix = {meta.id + ".fpkm_tpm.featureCounts_dexseq"}
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/featurecounts/dexseq"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'KALLISTO_QUANT'{
        ext.args = "-b 100"
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/kallisto"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'KALLISTO_RESCALE'{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/kallisto"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'ARRIBA_DOWNLOAD'{
        publishDir = [
                path: {"${params.outdir}/indexes/arriba"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'ARRIBA_ARRIBA'{
        ext.args = "-f 'no_genomic_support,genomic_support'"
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/arriba"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'ARRIBA_VISUALISATION'{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/arriba"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'ARRIBA_VIRAL_ALIGNMENTS|ARRIBA_FUSION_ALIGNMENT|ARRIBA_QUANTIFY_VIRUS '{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/arriba"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'QC_JSON'{
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/qc"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
    withName: 'RSEM_CALCULATEEXPRESSION' {
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/rsem"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'SALMON_QUANT' {
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/salmon"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }

    withName: 'RUSTQC' {
        ext.args = "--skip-dup-check --stranded forward"
        publishDir = [
                path: {"${params.outdir}/${meta.sample}/${meta.status}/${meta.replica}/rustqc"},
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
    }
}
